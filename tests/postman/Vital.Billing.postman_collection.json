              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('Healthy');",
              "  pm.expect(body.service).to.eql('saas-billing');",
              "  pm.expect(body.probe).to.eql('live');",
              "  pm.expect(body.scope).to.eql('process-only');",
              "});"
