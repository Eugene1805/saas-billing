{
  "info": {
    "name": "Vital - saas-billing (Incremento 1)",
    "description": "Pruebas automatizadas CU-20 (hojas de cargo ABIERTA->REVISADA->COBRADA), CU-21 (cobro completo sin exigir nota cerrada), CU-22/CU-23/PC-05 (cortes y discrepancias), ajustes compensatorios vinculados, CU-10, CU-16 y sondas Kubernetes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8084" },
    { "key": "jwtSigningKey", "value": "CHANGE_ME_SET_JWT_SIGNING_KEY" },
    { "key": "inProgressSheetId", "value": "" },
    { "key": "createdSheetId", "value": "" },
    { "key": "createdPaymentId", "value": "" },
    { "key": "createdCutId", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function base64url(source) {",
          "  let encoded = CryptoJS.enc.Base64.stringify(source);",
          "  encoded = encoded.replace(/=+$/, '');",
          "  encoded = encoded.replace(/\\+/g, '-');",
          "  encoded = encoded.replace(/\\//g, '_');",
          "  return encoded;",
          "}",
          "function signJwt(payload, secret) {",
          "  const header = { alg: 'HS256', typ: 'JWT' };",
          "  const now = Math.floor(Date.now() / 1000);",
          "  const fullPayload = Object.assign({",
          "    iss: 'saas-identity',",
          "    aud: 'vital-saas',",
          "    jti: pm.variables.replaceIn('{{$guid}}'),",
          "    iat: now,",
          "    nbf: now - 5,",
          "    exp: now + 900",
          "  }, payload);",
          "  const encodedHeader = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify(header)));",
          "  const encodedData = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify(fullPayload)));",
          "  const token = encodedHeader + '.' + encodedData;",
          "  const signature = base64url(CryptoJS.HmacSHA256(token, secret));",
          "  return token + '.' + signature;",
          "}",
          "const gmt6Now = new Date(Date.now() - 6 * 3600 * 1000);",
          "const todayGmt6Date = gmt6Now.getUTCFullYear() + '-' + String(gmt6Now.getUTCMonth() + 1).padStart(2, '0') + '-' + String(gmt6Now.getUTCDate()).padStart(2, '0');",
          "pm.variables.set('todayGmt6Date', todayGmt6Date);",
          "const key = pm.variables.get('jwtSigningKey');",
          "if (!key || key.startsWith('CHANGE_ME_')) {",
          "  throw new Error('Configura jwtSigningKey (entorno Postman o --env-var jwtSigningKey=...) antes de ejecutar la colección.');",
          "}",
          "pm.variables.set('adminNorteToken', signJwt({ sub: '20000000-0000-0000-0000-000000000002', tenant_id: '10000000-0000-0000-0000-000000000001', role: 'ADMIN_CLINICA', full_name: 'Lic. Mariana Paredes', email: 'admin@norte.vital.demo' }, key));",
          "pm.variables.set('auxNorteToken', signJwt({ sub: '20000000-0000-0000-0000-000000000005', tenant_id: '10000000-0000-0000-0000-000000000001', role: 'AUXILIAR', full_name: 'Enf. Clara Ramírez', email: 'aux.ramirez@norte.vital.demo' }, key));",
          "pm.variables.set('mendozaToken', signJwt({ sub: '20000000-0000-0000-0000-000000000003', tenant_id: '10000000-0000-0000-0000-000000000001', role: 'ESPECIALISTA', full_name: 'Dra. Sofía Mendoza', email: 'dra.mendoza@norte.vital.demo' }, key));",
          "pm.variables.set('salazarToken', signJwt({ sub: '20000000-0000-0000-0000-000000000004', tenant_id: '10000000-0000-0000-0000-000000000001', role: 'ESPECIALISTA', full_name: 'Dr. Mateo Salazar', email: 'dr.salazar@norte.vital.demo' }, key));",
          "pm.variables.set('superAdminToken', signJwt({ sub: '20000000-0000-0000-0000-000000000001', role: 'SUPER_ADMIN', full_name: 'Operador Plataforma SaaS', email: 'superadmin@vital.demo' }, key));",
          "pm.variables.set('adminValleToken', signJwt({ sub: '20000000-0000-0000-0000-000000000007', tenant_id: '10000000-0000-0000-0000-000000000002', role: 'ADMIN_CLINICA', full_name: 'Ing. Rodrigo Téllez', email: 'admin@valle.vital.demo' }, key));",
          "pm.variables.set('adminSurToken', signJwt({ sub: '20000000-0000-0000-0000-000000000009', tenant_id: '10000000-0000-0000-0000-000000000004', role: 'ADMIN_CLINICA', full_name: 'Admin Dispensario Sur', email: 'admin@sur.vital.demo' }, key));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01. Health check y PostgreSQL",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health retorna 200 Healthy con DB conectada en GMT-6', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('Healthy');",
              "  pm.expect(body.service).to.eql('saas-billing');",
              "  pm.expect(body.database).to.eql('Connected');",
              "  pm.expect(body.timestampGmt6).to.include('-06:00');",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "01b. Liveness probe (/health/live)",
      "event": [
        {
          "listen": "test",
